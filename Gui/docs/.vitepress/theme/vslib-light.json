{
  "name": "vslib-light",
  "type": "light",
  "colors": {
    "editor.background": "#E5DFC9",
    "editor.foreground": "#33240F"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#B08D3E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6B7A4F"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A69477",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#D1AB54"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#B08D3E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B08D3E"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#5C4B3F"
      }
    }
  ]
}
