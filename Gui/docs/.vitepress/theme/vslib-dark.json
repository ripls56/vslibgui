{
  "name": "vslib-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0E0B07",
    "editor.foreground": "#E9E1D1"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#D1AB54",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8C946E"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5C4B3F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#E5C37A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#D1AB54"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E5C37A"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#A69477"
      }
    }
  ]
}
